# Copy to .env — never commit the real one.
#
# Create an app at https://developer.spotify.com/dashboard
# then click "Edit Settings" and add your redirect URI.

# Required — your Spotify app's public identifier
SPOTIFY_CLIENT_ID=

# Required for the "user" auth flow (Authorization Code / PKCE)
SPOTIFY_CLIENT_SECRET=

# Must match a redirect URI registered on the Spotify app.
# The default below is what spotipy opens in your browser.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8877/callback

# Optional — override the default scope
# SPOTIFY_SCOPE=playlist-read-private playlist-modify-public playlist-modify-private user-read-currently-playing user-read-playback-state

# Optional — cache file for the token (defaults to ./.spotify-cache)
# SPOTIFY_CACHE_PATH=.spotify-cache